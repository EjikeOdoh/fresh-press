# ---------------------------------------------------------------------------
# FreshPress Dry Cleaners — environment template
#
# Copy to `.env` (never committed) and fill in real values:
#
#   cp .env.example .env
#
# NEVER commit `.env`. Generate BETTER_AUTH_SECRET with:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string.
# Neon dashboard -> Project -> Connect -> "Pooled connection" / "Direct connection".
# The WebSocket driver used by this app accepts the standard postgres:// URL and
# upgrades it automatically, e.g.
#   postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/freshpress?sslmode=require
DATABASE_URL=

# Better Auth -----------------------------------------------------------------
# 32+ character random string. Server-side only.
BETTER_AUTH_SECRET=
# Base URL of this application (used to build the Google OAuth callback URL).
# Development: http://localhost:3000
# Production:  https://your-domain.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailgun ---------------------------------------------------------------------
# Mailgun dashboard -> Sending -> Domain settings -> API keys
# If these are empty the app still places orders; it logs a warning and skips the
# confirmation email (so local development works before Mailgun is set up).
MAILGUN_API_KEY=
# e.g. mg.your-domain.com (the sending domain, not the API base domain)
MAILGUN_DOMAIN=
# e.g. FreshPress Dry Cleaners <orders@mg.your-domain.com>
MAILGUN_FROM=

# Public application URL (used for metadata, sitemap and links in emails) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000