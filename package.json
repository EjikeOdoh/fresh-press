  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/db/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-db.ts",
    "auth:generate": "npx --yes auth@1.7.7 generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
